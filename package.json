{
  "name": "fechtin-go",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FechTin Go — a living interactive map to explore Vietnam.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:content": "node scripts/check-content-locales.mjs",
    "check:zh": "node scripts/zh-simplify.mjs --check",
    "check:provinces": "node --experimental-strip-types scripts/verify-province-names.mjs",
    "fix:zh": "node scripts/zh-simplify.mjs",
    "video:add": "node scripts/add-video.mjs",
    "test": "vitest run",
    "worker:dev": "wrangler dev",
    "data:build": "node --experimental-strip-types scripts/build-map.mjs vn && node --experimental-strip-types scripts/build-map.mjs kr",
    "seo:build": "node --experimental-strip-types scripts/build-sitemap.mjs",
    "db:seed:build": "node --experimental-strip-types scripts/build-d1-seed.mjs",
    "images:fetch": "node --experimental-strip-types scripts/fetch-images.mjs",
    "images:dishes": "node --experimental-strip-types scripts/fetch-dish-images.mjs",
    "images:thumbs": "node scripts/build-thumbs.mjs",
    "images:propose": "PROPOSE=1 node --env-file-if-exists=.env --experimental-strip-types scripts/fetch-images.mjs",
    "review": "node scripts/review-server.mjs",
    "maps:naver": "node --experimental-strip-types scripts/resolve-naver-places.mjs",
    "maps:google": "node --env-file-if-exists=.env --experimental-strip-types scripts/resolve-google-places.mjs",
    "verify:seo": "node scripts/verify-locale-urls.mjs",
    "verify:kr": "node --experimental-strip-types scripts/verify-content.mjs kr",
    "verify:vn": "node --experimental-strip-types scripts/verify-content.mjs vn",
    "db:setup": "wrangler d1 migrations apply atlas_db --local && wrangler d1 execute atlas_db --local --file=db/seed.sql",
    "sweep:trips": "node --experimental-strip-types scripts/sweep-itineraries.mjs",
    "captions": "node scripts/apply-captions.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "d3-geo": "^3.1.1",
    "firebase": "^12.15.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.544.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "hono": "^4.9.8",
    "mapshaper": "^0.7.33",
    "opencc-js": "^1.4.1",
    "playwright-core": "^1.61.1",
    "sharp": "^0.35.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^4.1.9",
    "wrangler": "^4.40.0"
  }
}
